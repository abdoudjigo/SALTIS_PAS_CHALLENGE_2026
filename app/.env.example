# Copier vers app/.env.local (jamais commité). Seules les variables VITE_* sont lues par le front,
# et elles sont visibles dans le navigateur : n'y mettre AUCUN secret (pas de mot de passe Snowflake).

# URL de l'API FastAPI (sans / final) ; `python -m api` écoute sur le port 8080
VITE_API_URL=http://localhost:8080

# true = données d'exemple intégrées au front (aucune API nécessaire) ; false = vraie API
VITE_USE_MOCK=true

# Réglages séparés (facultatifs, chacun vaut VITE_USE_MOCK par défaut).
# Site déployé tant que le back d'authentification n'existe pas : VITE_AUTH_DEMO=true et VITE_DONNEES_DEMO=false.
# VITE_AUTH_DEMO=true      # comptes de démonstration, connexion et inscription dans le navigateur
# VITE_DONNEES_DEMO=false  # false = données de la vraie API

# Token public Mapbox (pk.…), restreint aux domaines du front dans le compte Mapbox.
# Jamais un jeton secret (sk.…) : le build le refuse (vite.config.ts).
# Vide = carte simplifiée sans fond de carte.
VITE_MAPBOX_TOKEN=

# Vue satellite sous la parcelle de l'agriculteur (true seulement si le compte Mapbox sert les tuiles satellite)
VITE_MAPBOX_SATELLITE=false

# Style Mapbox (optionnel)
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# Profil « association de producteurs de semences » (option B, cible à confirmer). false = profil et écran masqués.
VITE_ACTIVER_SEMENCIERS=true

# Adresse publique du site, sans / final (ex. https://assaman-suuf.com) : aperçus de partage (Open Graph).
# En production elle est déduite de DOMAINE (docker-compose.prod.yml).
VITE_URL_SITE=

# Pages publiques : adresse de contact (EMAIL_CONTACT, sans préfixe VITE_ : codée au build contre les robots
# ramasseurs d'adresses, affichée au clic) et réseaux sociaux (pied de page). Vide = affiché « bientôt ».
EMAIL_CONTACT=
VITE_LIEN_LINKEDIN=
VITE_LIEN_FACEBOOK=
VITE_LIEN_X=
VITE_LIEN_YOUTUBE=

# Mesure d'audience : identifiant du site dans Umami (public). Vide = aucune mesure et pas de bandeau cookies.
VITE_UMAMI_ID=
