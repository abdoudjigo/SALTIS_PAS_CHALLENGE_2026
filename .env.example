POSTGRES_USER=saltis
POSTGRES_PASSWORD=change_me
POSTGRES_DB=saltis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SNOWFLAKE_ACCOUNT=your_organization-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=SALTIS_WH
SNOWFLAKE_DATABASE=SALTIS
SNOWFLAKE_SCHEMA=PUBLIC
MAPBOX_TOKEN=

# API (api/) : lancement par `python -m api` (port 8080 par défaut)
# Redis est optionnel : laissé vide, le cache est en mémoire et rechargé depuis Snowflake à chaque démarrage.
# REDIS_URL=redis://localhost:6379/0
# API_PORT=8080
# Jeton des routes d'administration du cache (rafraîchir, retour arrière). Vide = administration désactivée.
API_ADMIN_TOKEN=
# Schéma Snowflake des marts lus par l'API (défaut : MARTS)
SNOWFLAKE_SCHEMA_MARTS=MARTS

# Voix wolof (mascotte WLF) : par défaut, produite par l'API elle-même (requirements-voix.txt, voir voix/README.md).
# Facultatif : un Space Hugging Face avec carte graphique (abonnement PRO), ex. compte/assaman-suuf-voix
VOIX_SPACE=
HF_TOKEN=

# Sécurité de l'API (facultatif ; valeurs par défaut dans api/config.py)
# Origines autorisées à appeler l'API depuis un navigateur. Développement : ["*"] ; production : [] (même origine).
# CORS_ORIGINES=["https://exemple.org"]
# Documentation interactive /docs : true en local, false en production (docker-compose.prod.yml)
# API_DOCS=true
# Débit par adresse IP et par minute (0 = sans limite)
# LIMITE_REQUETES_PAR_MINUTE=1200
# LIMITE_VOIX_TEXTE_PAR_MINUTE=60
# LIMITE_VOIX_SYNTHESE_PAR_MINUTE=20

# Déploiement (deploy/README.md)
# Mot de passe de Redis en production (facultatif, recommandé) : openssl rand -hex 24
REDIS_PASSWORD=
DOMAINE=:80
VITE_MAPBOX_TOKEN=
VITE_EMAIL_CONTACT=
