# Copier vers .env (jamais commité) : cp .env.example .env. Aucune valeur réelle dans ce fichier.

# Chargeur historique vers PostgreSQL (ingestion/load_modules.py, `make load`), facultatif
POSTGRES_USER=saltis
POSTGRES_PASSWORD=change_me
POSTGRES_DB=saltis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Snowflake : mêmes variables pour dbt, l'API et l'ingestion (identifiant du compte, pas l'URL de Snowsight)
SNOWFLAKE_ACCOUNT=your_organization-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=SALTIS_WH
SNOWFLAKE_DATABASE=SALTIS
SNOWFLAKE_SCHEMA=PUBLIC
# Résultats des modèles (ml/charger_snowflake.py) : schéma lu par l'API, et compte dédié au chargement (facultatif ;
# vides = SNOWFLAKE_USER, SNOWFLAKE_PASSWORD et SNOWFLAKE_ROLE)
SNOWFLAKE_SCHEMA_ML=ML
SNOWFLAKE_ML_USER=
SNOWFLAKE_ML_PASSWORD=
SNOWFLAKE_ML_ROLE=
# Jeton public Mapbox (pk.…) ; le front le lit sous le nom VITE_MAPBOX_TOKEN (app/.env.local, ou section Déploiement)
MAPBOX_TOKEN=

# API (api/) : lancement par `python -m api` (port 8080 par défaut)
# Redis est optionnel : laissé vide, le cache est en mémoire et rechargé depuis Snowflake à chaque démarrage.
# REDIS_URL=redis://localhost:6379/0
# API_PORT=8080
# Jeton des routes d'administration du cache (rafraîchir, retour arrière). Vide = administration désactivée.
API_ADMIN_TOKEN=
# Schéma Snowflake des marts lus par l'API (défaut : MARTS)
SNOWFLAKE_SCHEMA_MARTS=MARTS

# Voix wolof (mascotte WLF) : par défaut, produite par l'API elle-même (requirements-voix.txt, voir voix/README.md).
# Facultatif : un Space Hugging Face avec carte graphique (abonnement PRO), ex. compte/assaman-suuf-voix
VOIX_SPACE=
HF_TOKEN=

# Sécurité de l'API (facultatif ; valeurs par défaut dans api/config.py)
# Origines autorisées à appeler l'API depuis un navigateur. Développement : ["*"] ; production : [] (même origine).
# CORS_ORIGINES=["https://exemple.org"]
# Documentation interactive /docs : true en local, false en production (docker-compose.prod.yml)
# API_DOCS=true
# Débit par adresse IP et par minute (0 = sans limite)
# LIMITE_REQUETES_PAR_MINUTE=1200
# LIMITE_VOIX_TEXTE_PAR_MINUTE=60
# LIMITE_VOIX_SYNTHESE_PAR_MINUTE=20

# Déploiement (deploy/README.md)
# Mot de passe de Redis en production (facultatif, recommandé) : openssl rand -hex 24
REDIS_PASSWORD=
# Nom de domaine du site (ex. assaman-suuf.com), obligatoire : le site est servi en HTTPS seulement
DOMAINE=
VITE_MAPBOX_TOKEN=
# Adresse de contact du site (facultatif) : codée au build, affichée seulement au clic du visiteur (anti-spam).
# L'ancien nom VITE_EMAIL_CONTACT reste accepté par docker-compose.prod.yml.
EMAIL_CONTACT=

# Avis ONG (POST /api/v1/avis) envoyés par e-mail. Gmail : smtp.gmail.com, port 587 (STARTTLS),
# SMTP_PASSWORD = mot de passe d'application Gmail (pas le mot de passe du compte). Vide = envoi indisponible.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
AVIS_DESTINATAIRE=

# Mesure d'audience (Umami, deploy/README.md section 7). Deux secrets à générer : openssl rand -hex 24
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Identifiant du site, créé dans le tableau de bord d'Umami ; vide = aucune mesure (le site reste servi)
UMAMI_WEBSITE_ID=
