# DOMAINE : le nom de domaine (ex. assaman-suuf.com) → HTTPS automatique (Let's Encrypt).
# Sans domaine : DOMAINE=:80 → le site en http://<IP du VPS> (micro et géolocalisation indisponibles sans HTTPS).
{$DOMAINE::80} {
	encode zstd gzip

	# L'API, jamais exposée directement. Seul /api/* est transmis : /docs, /redoc et /openapi.json ne le sont pas.
	handle /api/* {
		# 6 Mo : une question parlée de 30 s (5 Mo au plus côté API) ; tout le reste est bien plus petit
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8080
	}

	# Le site (application d'une seule page)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@ressources path /assets/*
		header @ressources Cache-Control "public, max-age=31536000, immutable"
		@fonds path /geo/* /logos/*
		header @fonds Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
	}

	# En-têtes de sécurité, posés sur toutes les réponses (site et API) et prioritaires sur ceux de l'API
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		# Micro (question parlée) et géolocalisation pour le site seulement ; le reste est coupé
		Permissions-Policy "microphone=(self), geolocation=(self), camera=(), payment=(), usb=(), interest-cohort=()"
		# CSP : tout vient du site, sauf la carte Mapbox (tuiles, styles, polices, statistiques).
		#   - worker-src / child-src blob: : les workers de Mapbox GL ; 'self' : le service worker (hors ligne)
		#   - 'wasm-unsafe-eval' : décodeurs WebAssembly de Mapbox GL v3 (modèles 3D) ; pas de 'unsafe-eval' ni de script en ligne
		#   - style-src 'unsafe-inline' : styles posés par Mapbox GL et React (attribut style)
		#   - media-src data: : la voix wolof est jouée depuis une URL data:audio/wav
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.mapbox.com; font-src 'self' data:; connect-src 'self' https://formsubmit.co data: blob: https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com; worker-src 'self' blob:; child-src 'self' blob:; media-src 'self' data: blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
		-Via
	}
}
